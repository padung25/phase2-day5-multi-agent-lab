# Required if using a real LLM provider
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Optional tracing providers
ENABLE_REMOTE_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=multi-agent-research-lab

# Optional search provider
TAVILY_API_KEY=

# Runtime config
APP_ENV=local
LOG_LEVEL=INFO
MAX_ITERATIONS=6
TIMEOUT_SECONDS=60
MAX_RETRIES=2
